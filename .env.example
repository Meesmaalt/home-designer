# Portainer / docker compose keskkonnamuutujad

PORT=8080
PB_PORT=8090

# PocketBase admin (esimesel käivitamisel)
PB_ADMIN_EMAIL=admin@kodu.local
PB_ADMIN_PASSWORD=kodu123456

# Brauseri URL PocketBase'ile:
# A) Otse port (lihtne): jäta tühjaks → frontend kasutab same-host:8090
# B) Nginx proksi läbi frontendi: PB_PUBLIC_URL=/pb
# C) Täis-URL: PB_PUBLIC_URL=https://tools.example.com:8090
PB_PUBLIC_URL=
